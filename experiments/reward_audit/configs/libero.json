{
  "description": "Single-seed SAC sanity and frozen-reward OOD hypothesis tests; no online RM updates.",
  "defaults": {
    "suite": "libero_90",
    "seed": 100,
    "num_envs": 1,
    "steps": 100000,
    "horizon": 400,
    "settle_steps": 10,
    "train_init_states": 25,
    "eval_episodes": 25,
    "eval_every": 5000,
    "eval_videos": 1,
    "save_every": 10000,
    "log_every": 1000,
    "buffer_capacity": 100000,
    "updates_per_transition": 1,
    "torch_threads": 4,
    "worker_timeout": 1800,
    "initial_actor": null,
    "dino_checkpoint": "facebook/dinov2-small",
    "actor_hidden": [512, 512],
    "critic_hidden": [768, 512, 256],
    "reward_checkpoint": "robometer/Robometer-4B@beef63bc914c5c189329d49c6d712d96d632aa34",
    "reward_python": ".venv-reward/bin/python",
    "reward_camera": "agentview_image",
    "reward_batch_size": 4,
    "reward_formula": "progress_minus_one",
    "sparse_offset": -1.0,
    "max_frames": 8,
    "audit_sparse_rewards": false,
    "sac": {
      "learning_starts": 5000,
      "gamma": 0.99,
      "tau": 0.005,
      "batch_size": 128,
      "num_critics": 5,
      "n_critics_to_sample": 2,
      "pooled_critic_features": true,
      "target_update_interval": 1,
      "num_critic_updates_per_actor_update": 1,
      "num_updates_per_train_step": 1,
      "actor_optimizer_lr": 0.00001,
      "critic_optimizer_lr": 0.00001,
      "ent_coef_lr": 0.0003,
      "target_entropy": 0,
      "train_actor_with_entropy": true,
      "train_critic_with_entropy": false
    }
  },
  "runs": [
    {
      "name": "sanity_sparse",
      "comparison": "sanity",
      "task": "KITCHEN_SCENE5_close_the_top_drawer_of_the_cabinet",
      "reward": "sparse",
      "ood_claim": "paper_protocol_public_checkpoint"
    },
    {
      "name": "sanity_robometer",
      "comparison": "sanity",
      "task": "KITCHEN_SCENE5_close_the_top_drawer_of_the_cabinet",
      "reward": "robometer",
      "reward_formula": "progress_minus_one",
      "ood_claim": "paper_protocol_public_checkpoint"
    },
    {
      "name": "sanity_hybrid",
      "comparison": "sanity",
      "task": "KITCHEN_SCENE5_close_the_top_drawer_of_the_cabinet",
      "reward": "robometer",
      "reward_formula": "sparse_plus_progress",
      "ood_claim": "paper_protocol_public_checkpoint"
    },
    {
      "name": "ood_sparse",
      "comparison": "ood",
      "task": "KITCHEN_SCENE10_put_the_butter_at_the_front_in_the_top_drawer_of_the_cabinet_and_close_it",
      "reward": "sparse",
      "num_envs": 8,
      "steps": 200000,
      "ood_claim": "held_out_task"
    },
    {
      "name": "ood_robometer",
      "comparison": "ood",
      "task": "KITCHEN_SCENE10_put_the_butter_at_the_front_in_the_top_drawer_of_the_cabinet_and_close_it",
      "reward": "robometer",
      "num_envs": 8,
      "steps": 200000,
      "ood_claim": "held_out_task"
    },
    {
      "name": "ood_robometer_wrist",
      "comparison": "ood",
      "task": "KITCHEN_SCENE10_put_the_butter_at_the_front_in_the_top_drawer_of_the_cabinet_and_close_it",
      "reward": "robometer",
      "num_envs": 8,
      "steps": 200000,
      "reward_camera": "robot0_eye_in_hand_image",
      "ood_claim": "reward_observation_shift"
    }
  ]
}
